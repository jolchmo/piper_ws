#!/usr/bin/env bash
# 双臂配置文件

# ============================================================================
# CAN 接口配置
# ============================================================================
CAN_LEFT_LEADER="can_left_leader"
CAN_RIGHT_LEADER="can_right_leader"
CAN_LEFT_FOLLOWER="can_left_follower"
CAN_RIGHT_FOLLOWER="can_right_follower"
BITRATE=1000000

# USB 端口映射（根据实际情况修改）
# 使用 `sudo ethtool -i canX` 查看 bus-info 获取 USB 总线地址
declare -A USB_PORTS
USB_PORTS["1-2.1:1.0"]="$CAN_LEFT_LEADER:$BITRATE"
USB_PORTS["1-2.2:1.0"]="$CAN_RIGHT_LEADER:$BITRATE"
USB_PORTS["1-2.3:1.0"]="$CAN_LEFT_FOLLOWER:$BITRATE"
USB_PORTS["1-2.4:1.0"]="$CAN_RIGHT_FOLLOWER:$BITRATE"

# ============================================================================
# 相机配置
# ============================================================================
# 设置为空字符串 "" 禁用相机
CAMERA_PATH="/dev/video6"
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ============================================================================
# 数据集配置
# ============================================================================
LOCAL_DATASET_DIR="./datasets"
MISSION_NAME="piper_bimanual_pickandplace"
REPO_DATASET_NAME="jolch/piper_bimanual_pickandplace"
DEFAULT_NUM_EPISODES=50

# ============================================================================
# 训练配置
# ============================================================================
DEFAULT_POLICY="act"
