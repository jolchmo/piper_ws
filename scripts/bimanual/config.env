#!/usr/bin/env bash
# 双臂配置文件
# ============================================================================
# CAN 接口配置
# ============================================================================
CAN_LEFT_LEADER="can_l_lead"
CAN_LEFT_FOLLOWER="can_l_follower"
CAN_RIGHT_LEADER="can_r_leader"
CAN_RIGHT_FOLLOWER="can_r_follower"
BITRATE=1000000

# USB 端口映射（根据实际情况修改）
# 使用 `sudo ethtool -i canX` 查看 bus-info 获取 USB 总线地址
# 左left 右right 顺序与机械臂安装位置对应
declare -A USB_PORTS
USB_PORTS["1-2.2:1.0"]="$CAN_LEFT_LEADER:$BITRATE"
USB_PORTS["1-2.1:1.0"]="$CAN_LEFT_FOLLOWER:$BITRATE"
USB_PORTS["1-2.3.1:1.0"]="$CAN_RIGHT_LEADER:$BITRATE"
USB_PORTS["1-2.3.2:1.0"]="$CAN_RIGHT_FOLLOWER:$BITRATE"

# ============================================================================
# 相机配置
# ============================================================================
# 相机通用参数
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# 多相机配置 - 使用关联数组
# 格式: CAMERAS["相机名称"]="设备路径"
# 相机名称会作为数据集中的 key，例如 observation.images.gripper_cam
# 设置为空 declare -A CAMERAS 禁用所有相机
declare -A CAMERAS
CAMERAS["gripper_cam"]="/dev/gripper_cam"
CAMERAS["top_cam"]="/dev/top_cam"
# CAMERAS["side_cam"]="/dev/video2"



# ============================================================================
# 数据集配置
# ============================================================================
LOCAL_DATASET_DIR="./datasets"
MISSION_NAME="piper_bi"
REPO_USER="jolch"
DEFAULT_NUM_EPISODES=50

# ============================================================================
# 训练配置
# ============================================================================
DEFAULT_POLICY="smolvla"

# act
# diffusion
# groot
# pi0
# pi05
# rtc
# sac
# sarm
# smolvla
