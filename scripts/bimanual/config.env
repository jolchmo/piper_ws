#!/usr/bin/env bash
# ============================================================================
# Piper 双臂配置文件
# 只改这个文件；写成 ${VAR:-默认值} 的项可用环境变量临时覆盖。
# ============================================================================
WS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ============================================================================
# CAN 接口（用 `sudo ethtool -i canX` 查看 bus-info）
# 左 left / 右 right 顺序与机械臂安装位置对应
# ============================================================================
CAN_LEFT_LEADER="can_l_lead"
CAN_LEFT_FOLLOWER="can_l_follower"
CAN_RIGHT_LEADER="can_r_leader"
CAN_RIGHT_FOLLOWER="can_r_follower"
BITRATE=1000000

declare -A USB_PORTS
USB_PORTS["1-2.2:1.0"]="$CAN_LEFT_LEADER:$BITRATE"
USB_PORTS["1-2.1:1.0"]="$CAN_LEFT_FOLLOWER:$BITRATE"
USB_PORTS["1-2.3.1:1.0"]="$CAN_RIGHT_LEADER:$BITRATE"
USB_PORTS["1-2.3.2:1.0"]="$CAN_RIGHT_FOLLOWER:$BITRATE"

# ============================================================================
# 相机（双臂当前用单个 OpenCV 相机；CAMERA_PATH 留空则禁用相机）
# ============================================================================
CAMERA_PATH="${CAMERA_PATH:-}"
CAMERA_FPS="${CAMERA_FPS:-30}"
CAMERA_WIDTH="${CAMERA_WIDTH:-640}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-480}"

# ============================================================================
# 路径与身份
# ============================================================================
LOCAL_DATASET_DIR="${LOCAL_DATASET_DIR:-./datasets}"
LOCAL_MODEL_DIR="${LOCAL_MODEL_DIR:-./outputs/model}"
ROBOT="piper"
TASK_NAME="${TASK_NAME:-pnp}"   # pick and place
REPO_USER="jolch"

# ============================================================================
# 【每次运行常改】采集 / 训练
# ============================================================================
POLICY="${POLICY:-smolvla}"
NUM_EPISODES="${NUM_EPISODES:-50}"
RESUME="${RESUME:-false}"               # 录制是否续采
DATASET_PUSH_TO_HUB="${DATASET_PUSH_TO_HUB:-false}"
STATE_DIM="${STATE_DIM:-14}"            # 双臂关节状态维度
TRAIN_STEPS="${TRAIN_STEPS:-20000}"
BATCH_SIZE="${BATCH_SIZE:-64}"
NUM_WORKERS="${NUM_WORKERS:-8}"
SAVE_FREQ="${SAVE_FREQ:-2000}"
LOG_FREQ="${LOG_FREQ:-100}"
MODEL_PUSH_TO_HUB="${MODEL_PUSH_TO_HUB:-false}"
WANDB_ENABLE="${WANDB_ENABLE:-true}"
WANDB_PROJECT="${WANDB_PROJECT:-piper_training}"

# ============================================================================
# 派生名称（一般无需修改）
# ============================================================================
TIMESTAMP=$(date +"%Y%m%d_%H%M")
MISSION_NAME="${ROBOT}_${TASK_NAME}_${TIMESTAMP}"
RUN_ID="${ROBOT}_${POLICY}_${TIMESTAMP}"
LOCAL_DATASET_NAME="$LOCAL_DATASET_DIR/$MISSION_NAME"
REPO_DATASET_NAME="$REPO_USER/$MISSION_NAME"
LOCAL_MODEL_NAME="$LOCAL_MODEL_DIR/$RUN_ID"
REPO_MODEL_NAME="$REPO_USER/$RUN_ID"

# ============================================================================
# 可选策略：act  diffusion  groot  pi0  pi05  rtc  sac  sarm
#           smolvla  tdmpc  vqbet  wall_x  xvla
# ============================================================================
