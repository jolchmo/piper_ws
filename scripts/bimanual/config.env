#!/usr/bin/env bash
# ============================================================================
# Piper 双臂配置文件（命名/来源约定与单臂完全一致）
# 只改这个文件；写成 ${VAR:-默认值} 的项可用环境变量临时覆盖。
# ============================================================================
WS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ============================================================================
# CAN 接口（用 `sudo ethtool -i canX` 查看 bus-info）
# 左 left / 右 right 顺序与机械臂安装位置对应
# ============================================================================
CAN_LEFT_LEADER="can_l_lead"
CAN_LEFT_FOLLOWER="can_l_follower"
CAN_RIGHT_LEADER="can_r_leader"
CAN_RIGHT_FOLLOWER="can_r_follower"
BITRATE=1000000

declare -A USB_PORTS
USB_PORTS["1-2.2:1.0"]="$CAN_LEFT_LEADER:$BITRATE"
USB_PORTS["1-2.1:1.0"]="$CAN_LEFT_FOLLOWER:$BITRATE"
USB_PORTS["1-2.3.1:1.0"]="$CAN_RIGHT_LEADER:$BITRATE"
USB_PORTS["1-2.3.2:1.0"]="$CAN_RIGHT_FOLLOWER:$BITRATE"

# ============================================================================
# 相机（Intel RealSense，按序列号绑定，与单臂一致）
# 把序列号换成你的实际相机后取消注释；清空数组即可禁用全部相机。
# ============================================================================
CAMERA_FPS="${CAMERA_FPS:-30}"
CAMERA_WIDTH="${CAMERA_WIDTH:-640}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-480}"

declare -A CAMERAS
# CAMERAS["top_cam"]="请填入序列号"
# CAMERAS["left_cam"]="请填入序列号"
# CAMERAS["right_cam"]="请填入序列号"

# ============================================================================
# 路径与身份
# ============================================================================
LOCAL_DATASET_DIR="${LOCAL_DATASET_DIR:-./datasets}"
LOCAL_MODEL_DIR="${LOCAL_MODEL_DIR:-./outputs/model}"
ROBOT="piper"
REPO_USER="jolch"

# ============================================================================
# 实验身份（只改这几个就够了）
# ============================================================================
TASK="${TASK:-pnp}"                                          # 任务短名（pick and place）
DATE="${DATE:-$(date +%Y%m%d)}"                              # 日期；引用旧数据/模型时用 DATE=20260605 覆盖
POLICY="${POLICY:-smolvla}"                                  # 策略类型
TASK_DESC="${TASK_DESC:-Pick and place with both arms}"      # 录制时的任务自然语言指令
EVAL_DESC="${EVAL_DESC:-$TASK_DESC}"                         # 评估时的任务指令

# ============================================================================
# 来源开关：local = 用本地路径 / remote = 用 HuggingFace 仓库
# ============================================================================
DATASET_SOURCE="${DATASET_SOURCE:-local}"   # 训练读数据集来源 local|remote
MODEL_SOURCE="${MODEL_SOURCE:-local}"       # 评估读模型来源 local|remote（也可用命令行第一个参数直接传 ckpt）

# ============================================================================
# 【每次运行常改】采集 / 评估
# ============================================================================
NUM_EPISODES="${NUM_EPISODES:-50}"
RESUME="${RESUME:-false}"                                # 录制是否续采
DATASET_PUSH_TO_HUB="${DATASET_PUSH_TO_HUB:-false}"

# ============================================================================
# 【每次运行常改】训练
# ============================================================================
STATE_DIM="${STATE_DIM:-14}"            # 双臂关节状态维度（左右各 7）
TRAIN_STEPS="${TRAIN_STEPS:-20000}"
BATCH_SIZE="${BATCH_SIZE:-64}"
NUM_WORKERS="${NUM_WORKERS:-8}"
SAVE_FREQ="${SAVE_FREQ:-2000}"
LOG_FREQ="${LOG_FREQ:-100}"
MODEL_PUSH_TO_HUB="${MODEL_PUSH_TO_HUB:-false}"
WANDB_ENABLE="${WANDB_ENABLE:-true}"
WANDB_PROJECT="${WANDB_PROJECT:-piper_training}"

# ============================================================================
# 派生标识（_LOCAL = 本地路径，_REMOTE = HF 仓库；一般无需修改）
# ============================================================================
DATASET_ID="${ROBOT}_${DATE}_${TASK}"                    # piper_20260606_pnp
DATASET_LOCAL="$LOCAL_DATASET_DIR/$DATASET_ID"
DATASET_REMOTE="$REPO_USER/$DATASET_ID"

MODEL_ID="${ROBOT}_${DATE}_${TASK}_${POLICY}"            # piper_20260606_pnp_smolvla
MODEL_LOCAL="$LOCAL_MODEL_DIR/$MODEL_ID"
MODEL_REMOTE="$REPO_USER/$MODEL_ID"
CKPT_LOCAL="$MODEL_LOCAL/checkpoints/last/pretrained_model"
CKPT_REMOTE="$MODEL_REMOTE"

WANDB_RUN_ID="${WANDB_RUN_ID:-$MODEL_ID}"

# ============================================================================
# 可选策略：act  diffusion  groot  pi0  pi05  rtc  sac  sarm
#           smolvla  tdmpc  vqbet  wall_x  xvla
# ============================================================================
