#!/usr/bin/env bash
# 单臂配置文件
WS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


# ============================================================================
# CAN 接口配置
# ============================================================================
CAN_LEADER="can_leader"
CAN_FOLLOWER="can_follower"
BITRATE=1000000

# USB 端口映射（根据实际情况修改）
# 使用 `sudo ethtool -i canX` 查看 bus-info 获取 USB 总线地址
declare -A USB_PORTS
#左
USB_PORTS["1-2.2:1.0"]="$CAN_LEADER:$BITRATE"
USB_PORTS["1-2.1:1.0"]="$CAN_FOLLOWER:$BITRATE"
#右
# USB_PORTS["1-2.3.1:1.0"]="$CAN_LEADER:$BITRATE"
# USB_PORTS["1-2.3.2:1.0"]="$CAN_FOLLOWER:$BITRATE"

# ============================================================================
# 相机配置
# ============================================================================
# 相机通用参数
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# 多相机配置 - 使用关联数组
# 格式: CAMERAS["相机名称"]="设备路径"
# 相机名称会作为数据集中的 key，例如 observation.images.gripper_cam
# 设置为空 declare -A CAMERAS 禁用所有相机
declare -A CAMERAS
# CAMERAS["gripper_cam"]="/dev/video14"
CAMERAS["gripper_cam"]="/dev/gripper_cam"
CAMERAS["top_cam"]="/dev/top_cam"
# CAMERAS["side_cam"]="/dev/video2"

# ============================================================================
# 训练配置
# ============================================================================
POLICY="smolvla"


# ============================================================================
# 数据集配置
# ============================================================================
#服务器存储路径
# LOCAL_DATASET_DIR="../../../DATA/disk0/junxi/datasets"
# LOCAL_MODEL_DIR="../../../DATA/disk0/junxi/model"
#本地存储路径
LOCAL_DATASET_DIR="./datasets"
LOCAL_MODEL_DIR="./outputs/model"
ROBOT="piper"
TASK_NAME="pnp" # pick and place
REPO_USER="jolch"
NUM_EPISODES=50


TIMESTAMP=$(date +"%Y%m%d")
MISSION_NAME="${ROBOT}_${TASK_NAME}_${TIMESTAMP}"
RUN_ID="${ROBOT}_${POLICY}_${TIMESTAMP}"

LOCAL_DATASET_NAME="$LOCAL_DATASET_DIR/$MISSION_NAME"
REPO_DATASET_NAME="$REPO_USER/$MISSION_NAME"
DATASET_PUSH_TO_HUB=true

LOCAL_MODEL_NAME="$LOCAL_MODEL_DIR/$RUN_ID"
REPO_MODEL_NAME="$REPO_USER/$RUN_ID"
MODEL_PUSH_TO_HUB=true


#评估数据集保存




# act
# diffusion
# groot
# pi0
# pi05
# rtc
# sac
# sarm
# smolvla
# tdmpc
# vqbet
