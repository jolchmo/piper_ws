#!/usr/bin/env bash
# ============================================================================
# Piper 单臂配置文件
# ----------------------------------------------------------------------------
# 只改这个文件，不要改各阶段 *.sh 脚本。
# 凡是写成 ${VAR:-默认值} 的项都可用环境变量临时覆盖，无需编辑文件，例如：
#     NUM_EPISODES=30 bash scripts/single/2_record_dataset.sh
#     DATE=20260605 bash scripts/single/3_train_policy.sh      # 训练某天采的数据
#     DATASET_SOURCE=remote bash scripts/single/3_train_policy.sh   # 从 HF 拉数据集
#     MODEL_SOURCE=remote   bash scripts/single/4_eval_policy.sh    # 评估 HF 上的模型
# ============================================================================
WS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ============================================================================
# CAN 接口（用 `sudo ethtool -i canX` 查看 bus-info）
# ============================================================================
CAN_LEADER="can_leader"
CAN_FOLLOWER="can_follower"
BITRATE=1000000

declare -A USB_PORTS
USB_PORTS["1-12:1.0"]="$CAN_LEADER:$BITRATE"
USB_PORTS["1-10:1.0"]="$CAN_FOLLOWER:$BITRATE"

# ============================================================================
# 相机（Intel RealSense，按序列号绑定；key 会成为数据集特征名 observation.images.<key>，
# 并自动进入训练的 input_features）。清空 CAMERAS 数组即可禁用全部相机。
# ============================================================================
CAMERA_FPS="${CAMERA_FPS:-30}"
CAMERA_WIDTH="${CAMERA_WIDTH:-640}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-480}"

declare -A CAMERAS
CAMERAS["gripper_cam"]="315122272530"
CAMERAS["top_cam"]="017322071981"

# ============================================================================
# 路径与身份
# ============================================================================
LOCAL_DATASET_DIR="${LOCAL_DATASET_DIR:-./datasets}"
LOCAL_MODEL_DIR="${LOCAL_MODEL_DIR:-./outputs/model}"
ROBOT="piper"
REPO_USER="jolch"

# ============================================================================
# 实验身份（只改这几个就够了）
# ============================================================================
TASK="${TASK:-pig_rgy}"                                          # 任务短名（slug）
DATE="${DATE:-$(date +%Y%m%d)}"                                  # 日期；引用旧数据/模型时用 DATE=20260605 覆盖
POLICY="${POLICY:-wall_x}"                                       # 策略类型
TASK_DESC="${TASK_DESC:-Place the toy into the yellow bowl}"     # 录制时的任务自然语言指令
EVAL_DESC="${EVAL_DESC:-$TASK_DESC}"                             # 评估时的任务指令

# ============================================================================
# 来源开关：local = 用本地路径 / remote = 用 HuggingFace 仓库
# ============================================================================
DATASET_SOURCE="${DATASET_SOURCE:-local}"   # 训练读数据集来源 local|remote
MODEL_SOURCE="${MODEL_SOURCE:-local}"       # 评估读模型来源 local|remote（也可用命令行第一个参数直接传 ckpt）

# ============================================================================
# 【每次运行常改】数据采集 / 评估
# ============================================================================
NUM_EPISODES="${NUM_EPISODES:-50}"                       # 采集/评估的 episode 数量
RESUME="${RESUME:-true}"                                 # 录制是否续采到已有数据集
DATASET_PUSH_TO_HUB="${DATASET_PUSH_TO_HUB:-true}"       # 录制后是否上传数据集到 HF

# ============================================================================
# 【每次运行常改】训练（3_train_policy.sh 针对 wall_x 调优）
# ============================================================================
STATE_DIM="${STATE_DIM:-7}"                              # 关节状态维度（单臂=7）
TRAIN_STEPS="${TRAIN_STEPS:-10000}"
BATCH_SIZE="${BATCH_SIZE:-16}"
NUM_WORKERS="${NUM_WORKERS:-16}"
NUM_GPUS="${NUM_GPUS:-4}"                                # torchrun --nproc_per_node
SAVE_FREQ="${SAVE_FREQ:-2000}"
LOG_FREQ="${LOG_FREQ:-100}"
MODEL_PUSH_TO_HUB="${MODEL_PUSH_TO_HUB:-false}"          # 训练后是否上传模型到 HF
WANDB_ENABLE="${WANDB_ENABLE:-true}"                     # 需先 `wandb login`
WANDB_PROJECT="${WANDB_PROJECT:-piper_training}"
EXTRA_CPATH="${EXTRA_CPATH:-}"                           # 某些机器编译 wall_x 需额外 CPATH，留空则不设置

# ============================================================================
# 派生标识（_LOCAL = 本地路径，_REMOTE = HF 仓库；一般无需修改）
# ============================================================================
DATASET_ID="${ROBOT}_${DATE}_${TASK}"                    # piper_20260606_pig_rgy
DATASET_LOCAL="$LOCAL_DATASET_DIR/$DATASET_ID"
DATASET_REMOTE="$REPO_USER/$DATASET_ID"

MODEL_ID="${ROBOT}_${DATE}_${TASK}_${POLICY}"            # piper_20260606_pig_rgy_wall_x
MODEL_LOCAL="$LOCAL_MODEL_DIR/$MODEL_ID"
MODEL_REMOTE="$REPO_USER/$MODEL_ID"
CKPT_LOCAL="$MODEL_LOCAL/checkpoints/last/pretrained_model"   # 训练产物默认 ckpt
CKPT_REMOTE="$MODEL_REMOTE"

WANDB_RUN_ID="${WANDB_RUN_ID:-$MODEL_ID}"

# ============================================================================
# 可选策略：act  diffusion  groot  pi0  pi05  rtc  sac  sarm
#           smolvla  tdmpc  vqbet  wall_x  xvla
# ============================================================================
