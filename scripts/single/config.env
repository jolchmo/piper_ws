#!/usr/bin/env bash
# 单臂配置文件

# ============================================================================
# CAN 接口配置
# ============================================================================
CAN_LEADER="can_leader"
CAN_FOLLOWER="can_follower"
BITRATE=1000000

# USB 端口映射（根据实际情况修改）
# 使用 `sudo ethtool -i canX` 查看 bus-info 获取 USB 总线地址
declare -A USB_PORTS
#左
USB_PORTS["1-2.2:1.0"]="$CAN_LEADER:$BITRATE"
USB_PORTS["1-2.1:1.0"]="$CAN_FOLLOWER:$BITRATE"
#右
# USB_PORTS["1-2.3.1:1.0"]="$CAN_RIGHT_LEADER:$BITRATE"
# USB_PORTS["1-2.3.2:1.0"]="$CAN_RIGHT_FOLLOWER:$BITRATE"

# ============================================================================
# 相机配置
# ============================================================================
# 相机通用参数
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# 多相机配置 - 使用关联数组
# 格式: CAMERAS["相机名称"]="设备路径"
# 相机名称会作为数据集中的 key，例如 observation.images.gripper_cam
# 设置为空 declare -A CAMERAS 禁用所有相机
declare -A CAMERAS
# CAMERAS["gripper_cam"]="/dev/video14"
CAMERAS["gripper_cam"]="/dev/gripper_cam"
CAMERAS["top_cam"]="/dev/top_cam"
# CAMERAS["side_cam"]="/dev/video2"


# ============================================================================
# 数据集配置
# ============================================================================
LOCAL_DATASET_DIR="./datasets"
MISSION_NAME="piper_pickandplace"
REPO_USER="jolch"
DEFAULT_NUM_EPISODES=50

# ============================================================================
# 训练配置
# ============================================================================
DEFAULT_POLICY="smolvla"

# act
# diffusion
# groot
# pi0
# pi05
# rtc
# sac
# sarm
# smolvla
# tdmpc
# vqbet
# wall_x
# xvla